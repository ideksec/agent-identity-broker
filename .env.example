# Copy to .env and fill in. .env is git-ignored.

# ---- GitHub App (Phase 2+) ----
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=

# ---- AWS federation (Phase 3+) ----
# Public URL where AWS can fetch broker JWKS (e.g. ngrok tunnel).
BROKER_FEDERATION_ISSUER=
DEMO_AWS_ROLE_ARN=
DEMO_AWS_REGION=us-east-1

# ---- Local cluster ----
KIND_CLUSTER_NAME=broker

# ---- Phase 1 has no required env beyond defaults; the Makefile generates
# the in-cluster vault key, postgres password, mock-idp signing key, and
# broker federation key as Kubernetes Secrets at `make seed` time. ----
